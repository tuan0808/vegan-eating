#DATABASE_URL="file:./dev.db"
AUTH_SECRET=
AUTH_URL=https://veganeating.com

RESEND_API_KEY=
RESEND_AUDIENCE_ID=

MAINTENANCE_BYPASS_TOKEN=
NEWSDATA_API_KEY=

CRON_SECRET=

SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_BUCKET=veganeating-media
SPACES_KEY=
SPACES_SECRET=
SPACES_REGION=us-east-1
SPACES_PUBLIC_BASE=https://veganeating-media.nyc3.cdn.digitaloceanspaces.com

# Public origin, used for canonical URLs, Open Graph tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://veganeating.com
# CDN/Spaces base for relative media paths in JSON-LD + image URLs. Falls back
# to serving from /public when unset (fine for local dev).
NEXT_PUBLIC_MEDIA_BASE_URL=https://veganeating-media.nyc3.cdn.digitaloceanspaces.com

# --- Analytics ---
# Optional salt for the cookieless visitor hash. Falls back to NEXTAUTH_SECRET.
ANALYTICS_SALT=
# Google Search Console (powers the "Search queries & rankings" panel in the
# admin Analytics dashboard). Leave blank to keep that panel dormant. Setup
# steps are documented at the top of src/lib/search-console.ts.
GSC_SITE_URL=          # e.g. sc-domain:veganeating.com  OR  https://veganeating.com/
GSC_CLIENT_EMAIL=      # service-account email
GSC_PRIVATE_KEY=       # service-account private key (PEM; keep the \n escapes)

# --- Reddit Ads tracking (pixel + Conversions API) ---
# All Reddit tracking is dormant until the pixel id is set. From Reddit Ads
# Manager → Events Manager. The pixel id (format "a2_xxxxxxxxxx") is public and
# doubles as the CAPI account id; the access token is a secret — never NEXT_PUBLIC_.
NEXT_PUBLIC_REDDIT_PIXEL_ID=            # a2_xxxxxxxxxx — loads the browser pixel
REDDIT_CONVERSION_ACCESS_TOKEN=        # secret bearer token for the Conversions API
REDDIT_CAPI_ACCOUNT_ID=                # optional — defaults to NEXT_PUBLIC_REDDIT_PIXEL_ID
REDDIT_CAPI_TEST_MODE=                 # "1" to route CAPI events to Reddit's test view


# --- Places / "Vegan Food Near Me" (OpenStreetMap) -------------------------
# All optional — the defaults below are what the code falls back to. No API
# keys exist for these services; the User-Agent IS the identity, so set a real
# contact URL before running the ingest at scale or you risk a block.
OVERPASS_ENDPOINT=                     # default https://overpass-api.de/api/interpreter
OVERPASS_ENDPOINT_FALLBACK=            # default https://overpass.kumi.systems/api/interpreter
NOMINATIM_ENDPOINT=                    # default https://nominatim.openstreetmap.org
GEO_USER_AGENT=                        # "vegan eating (https://veganeating.com; you@example.com)"

# IP geolocation for the tool's zero-click default + home "near you" section.
IP_GEO_URL=                            # default https://ipwho.is/{ip}
HOME_NEAR_LAT=                         # featured-city fallback when IP can't resolve (default Fort Lauderdale)
HOME_NEAR_LNG=
HOME_NEAR_LABEL=

# --- Instagram home-page strip ------------------------------------------------
# Latest @VeganEating_Com posts on the home page (src/lib/instagram.ts). The
# section stays hidden until a token is set. IG_ACCESS_TOKEN is the SEED for a
# long-lived (60-day) token; it's refreshed automatically — lazily on read and
# via the CRON_SECRET-guarded /api/instagram/refresh route — and the rotated
# token is persisted in the Setting table (env vars are immutable at runtime).
IG_ACCESS_TOKEN=                       # long-lived token for an IG Business/Creator account
IG_USER_ID=                            # the IG user id the token belongs to (own-feed media)
IG_HASHTAG_ID=                         # optional: hashtag node id for tagged media (needs hashtag_search)
NEXT_PUBLIC_IG_HANDLE=                 # default VeganEating_Com — shown in the UI (not a secret)
NEXT_PUBLIC_IG_HASHTAG=                # default VeganEating — shown in the UI (not a secret)

# Google Places (New) photos on place cards. OPTIONAL and BILLED — with no key,
# cards keep their gradient placeholders. Needs Places API (New) enabled +
# billing. Only the place_id/photo reference is cached; images are proxied on
# demand (never stored) via /api/place-photo, with Google attribution shown.
GOOGLE_MAPS_API_KEY=
